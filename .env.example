# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Кому можно пользоваться ботом (id через запятую). Пусто = всем.
# Свой id бот покажет в ответ на /start, если ты не в списке.
ALLOWED_USERS=

# Telegram API для чтения каналов: https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=abcdef0123456789abcdef0123456789
TG_SESSION=parser

# Instagram: логин аккаунта, под которым создана сессия instaloader (лучше отдельный, не основной)
IG_USERNAME=
# Путь к файлу сессии (пусто = стандартный путь instaloader)
IG_SESSION_FILE=

TZ_NAME=Europe/Astrakhan
DEFAULT_HOURS=24
PREVIEW_LEN=300
